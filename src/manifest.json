{
    "manifest_version": 2,
    "name": "Media Catch",
    "version": "1.1.0",
    "description": "Download images in bulk, capture file blobs, discover HLS playlists, and remux supported media to MP4 locally.",
    "icons": {
        "48": "icons/blob-download.svg",
        "96": "icons/blob-download.svg"
    },
    "permissions": ["activeTab", "scripting", "downloads", "webRequest", "storage"],
    "options_ui": { "page": "index.html", "open_in_tab": true, "browser_style": false },
    "optional_permissions": ["http://*/*", "https://*/*"],
    "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'",
    "background": {
        "scripts": ["background.js"]
    },
    "browser_action": {
        "default_title": "Media Catch",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/blob-download.svg",
            "32": "icons/blob-download.svg"
        }
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "blob-url-downloader@local.invalid",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
